<?xml version="1.0"?>
<!--
  ShootDodge (C2SD-T37, C2SD-T39): Bullet Time mode's default key, / (the slash key, main keyboard or numpad).

  Read by Input Loader (Nexus mod 4575, RED4ext plugin), which merges every r6/input/*.xml into the
  game's input config at startup. Without Input Loader this file is ignored and the CET binding
  (Bindings tab, "Bullet-time mode (Max Payne 2, toggle)") is the only route.

  C2SD-T40: IK_Slash and IK_NumSlash are bound in no context of the vanilla inputUserMappings.xml (see DESIGN.md for
  the full used-key list), unlike IK_Enter, which is also main Enter and the dialogue confirm. The
  action lives in the on-foot Locomotion context, which Exploration and Aiming include, so it does
  nothing in vehicles or menus.
  r6/scripts/ShootDodge/ShootDodgeBulletTimeKey.reds listens for the action and the CET side turns
  each press into MeterDriver.ToggleMode (debounced against the CET binding).
-->
<bindings>
	<context name="ShootDodgeActions" >
		<action name="ShootDodgeBulletTime"		map="ShootDodgeBulletTime_Button" />
		<action name="ShootDodgeModifier"		map="ShootDodgeModifier_Button" />
	</context>

	<context name="Locomotion" append="true">
		<include name="ShootDodgeActions" />
	</context>

	<mapping name="ShootDodgeBulletTime_Button" type="Button" >
		<button id="IK_Slash" />
		<button id="IK_NumSlash" />
	</mapping>

	<!-- C2SD-T51: Shift (either), read as "held" so Shift + Space is the Shootdodge (C2SD-T46 had Ctrl).
	     Vanilla also uses Shift for sprint; this action only listens, it blocks nothing. -->
	<mapping name="ShootDodgeModifier_Button" type="Button" >
		<button id="IK_LShift" />
		<button id="IK_RShift" />
	</mapping>
</bindings>
